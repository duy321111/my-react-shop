# Docker-only environment values (separate from local .env)
# Copy this file to .env.docker and update values.

# Option 1: Use Mongo in docker-compose
MONGO_URI_DOCKER=mongodb://mongo:27017/myreactshop_docker

# Option 2: Use MongoDB Cloud (Atlas)
# MONGO_URI_DOCKER=mongodb+srv://<username>:<password>@<cluster>/<db_name>?retryWrites=true&w=majority

JWT_SECRET_DOCKER=change_this_secret_in_production
